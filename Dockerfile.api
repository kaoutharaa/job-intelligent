FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.110.0 \
    uvicorn==0.29.0 \
    sqlalchemy==1.4.53 \
    psycopg2-binary==2.9.9 \
    pandas==2.2.1 \
    scikit-learn \
    python-multipart \
    PyPDF2 \
    PyJWT \
    email-validator

COPY api/api.py .

# Run as an unprivileged user (UID matches runAsUser in k8s/api.yaml)
RUN useradd --uid 10001 --no-create-home appuser
USER 10001

EXPOSE 8000

# No --reload: that is a dev-only file watcher.
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
