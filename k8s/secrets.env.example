# Copy to k8s/secrets.env (git-ignored) and fill in the values.
# Kustomize turns this file into the Secret "app-secrets".
# scripts/deploy.ps1 generates this file automatically if it is missing
# (you still have to fill FT_CLIENT_ID / FT_CLIENT_SECRET yourself).
DB_PASS=change-me
JWT_SECRET=replace-with-a-long-random-string
# Airflow: FERNET_KEY = 32 random bytes, url-safe base64
FERNET_KEY=
SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=
# France Travail API (https://francetravail.io)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
